[Unit]
Description=Control de acceso RFID con LCD, servo y panel web
After=network.target pigpiod.service
Requires=pigpiod.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/rfid-acceso
ExecStart=/usr/bin/python3 /home/pi/rfid-acceso/acceso_rfid.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
